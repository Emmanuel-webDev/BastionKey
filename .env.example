# Demo mode. "local" (default) runs the real policy rules in-process with a local signer
# and a local attestor so anyone can reproduce the demos with no keys.
# "testnet" calls the deployed contract, v1.signer-prod.testnet and NEAR AI Cloud.
BASTION_MODE=local

# --- testnet mode only ---
NEAR_NETWORK=testnet
BASTION_CONTRACT_ID=
AGENT_ACCOUNT_ID=
# Function Call Key of the agent account. Never commit a real value.
AGENT_PRIVATE_KEY=
# NEAR AI Cloud API key from https://cloud.near.ai
NEARAI_API_KEY=
NEARAI_MODEL=deepseek-ai/DeepSeek-V3.1
# Optional 1Click JWT (avoids the 0.2% fee). https://partners.near-intents.org
ONECLICK_JWT=
BASE_SEPOLIA_RPC=https://sepolia.base.org
