# BastionKey Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env or secrets.

# Execution mode: "testnet" (live NEAR & EVM) or "offline" (local mock harness)
BASTION_MODE=testnet

# NEAR Network & Contract
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
BASTION_CONTRACT_ID=your-contract.testnet
AGENT_ACCOUNT_ID=your-agent.testnet

# Agent's restricted Function Call Key (request_signature permission only).
# NEVER use an owner or Full Access key for the agent.
AGENT_PRIVATE_KEY=ed25519:YourAgentFunctionCallPrivateKeyHere

# Contract Owner Private Key (ONLY needed for `bastion policy set`, `agent pause/resume`, `breaker reset`)
# Can also be loaded automatically from ~/.near-credentials/testnet/
BASTION_OWNER_PRIVATE_KEY=

# NEAR AI Cloud API key (from https://cloud.near.ai) for live TEE semantic verification
NEARAI_API_KEY=
NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Target EVM Chain & RPC (Defaults to Base Sepolia)
BASTION_CHAIN_ID=84532
BASTION_EVM_RPC=https://sepolia.base.org

# Optional Local Daemon & Audit Settings
BASTION_AUDIT_LOG=./bastion-audit.jsonl
BASTION_SERVER_HOST=127.0.0.1
BASTION_SERVER_PORT=8443
BASTION_SERVER_BEARER=your-secret-local-bearer-token

# Optional 1Click Intents JWT (avoids the 0.2% fee). https://partners.near-intents.org
ONECLICK_JWT=
